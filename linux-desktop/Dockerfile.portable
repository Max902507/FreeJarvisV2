# Debian 12 / glibc 2.36 build baseline, independent of target DE.
FROM node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip libpython3.11 espeak-ng git ca-certificates binutils \
    libgtk-3-0 libnss3 libasound2 libgbm1 libxss1 libfuse2 xdg-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
